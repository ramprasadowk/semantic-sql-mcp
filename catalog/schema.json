{
  "schema": "sales_demo",
  "currency": "USD",
  "tables": {
    "customers": {"description": "Synthetic customers and their sales regions.", "primary_key": ["customer_id"], "columns": {"customer_id": "integer", "name": "text", "region": "text"}},
    "products": {"description": "Product catalog. Use order_items.unit_price for historical revenue.", "primary_key": ["product_id"], "columns": {"product_id": "integer", "name": "text", "category": "text", "unit_price": "numeric"}},
    "orders": {"description": "One row per order. Status is completed, pending, or cancelled; order_date is a date.", "primary_key": ["order_id"], "columns": {"order_id": "integer", "customer_id": "integer", "order_date": "date", "status": "text"}},
    "order_items": {"description": "One row per product per order; quantity and historical sale price.", "primary_key": ["order_id", "product_id"], "columns": {"order_id": "integer", "product_id": "integer", "quantity": "integer", "unit_price": "numeric"}}
  },
  "relationships": [
    {"from": "orders.customer_id", "to": "customers.customer_id", "cardinality": "many-to-one"},
    {"from": "order_items.order_id", "to": "orders.order_id", "cardinality": "many-to-one"},
    {"from": "order_items.product_id", "to": "products.product_id", "cardinality": "many-to-one"}
  ]
}
